@model IEnumerable<EmprestimoModel> 

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5"> 
        <h1>Lista de Empréstimos</h1>
		
        <div>
            <a class="btn btn-success mx-2" asp-controller="Emprestimo" asp-action="Cadastrar">Novo Empréstimo</a>
            <a class="btn btn-success mx-2" asp-controller="Emprestimo" asp-action="Exportar">Exportar Empréstimos</a>
        </div>

<table class="table table-dark table-hover">
    <thead>
        <tr>
            <th scope="col">Recebedor</th>
            <th scope="col">Fornecedor</th>
            <th scope="col">Livro</th>
            <th scope="col">Data Emprestimo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@item.Recebedor</th>
                    <td>@item.Fornecedor</td>
                    <td>@item.LivroEmprestado</td>
                    <td>@item.UltimaAlteracao</td>
                    <td>
                        <a asp-controller="Emprestimo" asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning mx-2"> Editar</a>
                                <a asp-controller="Emprestimo" asp-action="Excluir" asp-route-id="@item.Id" class=" btn btn-danger mx-2"> Excluir</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">Nenhum empréstimo encontrado no banco de dados.</td>
            </tr>
        }
    </tbody>
</table>
</div>